---
import "../styles/global.css";
import AnimatedBackground from "../components/AnimatedBackground.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import ExecutiveProfile from "../components/ExecutiveProfile.astro";
import Certificates from "../components/Certificates.astro";
import Services from "../components/Services.astro";
import Faq from "../components/Faq.astro";
import FinalCTA from "../components/FinalCTA.astro";
import Footer from "../components/Footer.astro";
import FloatingWhatsApp from "../components/FloatingWhatsApp.astro";
import WhatsAppScript from "../components/WhatsAppScript.astro";
import { getImage } from "astro:assets";
import sharePhoto from "../assets/about-photo.avif";

const title = "Lísia Helena Guerra | Gestão Condominial";
const description =
  "Síndica profissional em Porto Alegre, com 19 anos de experiência em gestão condominial. Controle financeiro, manutenção, contratos e mediação de conflitos com transparência.";

// Imagem de compartilhamento (WhatsApp, redes sociais). Precisa de URL absoluta,
// então só é gerada quando `site` está definido em astro.config.mjs.
const shareImage = await getImage({ src: sharePhoto, width: 1200, format: "jpg" });
const shareImageUrl = Astro.site ? new URL(shareImage.src, Astro.site).href : undefined;
const pageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif:ital,wght@0,100..900;1,100..900&family=Space+Grotesk:wght@300..700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    {pageUrl && <link rel="canonical" href={pageUrl} />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Lísia Helena Guerra" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {pageUrl && <meta property="og:url" content={pageUrl} />}
    {shareImageUrl && <meta property="og:image" content={shareImageUrl} />}
    {shareImageUrl && <meta property="og:image:alt" content="Lísia Helena Guerra, síndica profissional" />}
    <meta name="twitter:card" content={shareImageUrl ? "summary_large_image" : "summary"} />
  </head>
  <body
    class="font-body text-on-surface selection:bg-primary selection:text-on-primary"
  >
    <AnimatedBackground />
    <Header />
    <main class="pt-20">
      <Hero />
      <ExecutiveProfile />
      <Certificates />
      <Services />
      <Faq />
      <FinalCTA />
    </main>
    <Footer />
    <FloatingWhatsApp />
    <WhatsAppScript />
  </body>
</html>
