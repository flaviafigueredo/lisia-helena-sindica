---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  label: string;
  detail: string;
  widths: number[];
  sizes: string;
  class?: string;
}

const { src, alt, label, detail, widths, sizes, class: className } = Astro.props;
---

<button
  type="button"
  class:list={[
    "js-cert-open glass-panel p-3 text-left group hover:bg-surface-container/40 transition-all duration-500 cursor-zoom-in",
    className,
  ]}
  data-full={src.src}
  data-alt={alt}
  aria-label={`Ampliar: ${label}`}
>
  <div class="overflow-hidden bg-surface-dim">
    <Image
      src={src}
      alt={alt}
      widths={widths}
      sizes={sizes}
      class="w-full h-auto opacity-90 group-hover:opacity-100 group-hover:scale-[1.02] transition-all duration-700"
    />
  </div>
  <div class="px-3 pt-5 pb-2">
    <h3 class="font-headline text-xl text-white mb-1">{label}</h3>
    <p class="font-label text-[10px] uppercase tracking-widest text-primary">
      {detail}
    </p>
  </div>
</button>
