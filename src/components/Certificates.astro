---
import CertificateCard from "./CertificateCard.astro";
import certFacop from "../assets/certificados/3.jpeg";
import certCursos1 from "../assets/certificados/1.jpeg";
import certCursos2 from "../assets/certificados/2.jpeg";
import certTownSq from "../assets/certificados/4.jpeg";
import certHashtag from "../assets/certificados/5.jpeg";

// Cada linha tem uma imagem vertical (5 colunas) e uma ou mais horizontais
// empilhadas (7 colunas). `reverse` inverte os lados para alternar as linhas.
const rows = [
  {
    reverse: false,
    tall: {
      src: certFacop,
      alt: "Certificado de conclusão do curso Formação Síndico Capacitado (FSC) pela FACOP, com 23 horas de carga horária",
      label: "Formação Síndico Capacitado",
      detail: "FACOP · 23 horas",
    },
    wide: [
      {
        src: certCursos1,
        alt: "Painel com certificados de cursos CondoHábil e Duarte Treinamentos concluídos por Lísia Helena Guerra",
        label: "Cursos de Especialização",
        detail: "CondoHábil · Duarte Treinamentos",
      },
      {
        src: certCursos2,
        alt: "Painel com certificados de cursos de gestão condominial concluídos por Lísia Helena Guerra",
        label: "Formação Contínua",
        detail: "Escola CondoHábil",
      },
    ],
  },
  {
    reverse: true,
    tall: {
      src: certHashtag,
      alt: "Painel com certificados da Hashtag Treinamentos em inteligência artificial concluídos por Lísia Helena Guerra",
      label: "Inteligência Artificial",
      detail: "Hashtag Treinamentos",
    },
    wide: [
      {
        src: certTownSq,
        alt: "Painel com certificados da TownSq concluídos por Lísia Helena Guerra, incluindo curso para síndicos e aula sobre assembleias",
        label: "Capacitação para Síndicos",
        detail: "TownSq",
      },
    ],
  },
];
---

<section id="certificados" class="px-8 py-16 md:py-24 max-w-7xl mx-auto">
  <div class="mb-16 max-w-3xl">
    <div class="flex items-center gap-3 mb-4">
      <span class="w-8 h-[1px] bg-primary"></span>
      <span
        class="font-label text-primary text-[10px] tracking-[0.2em] uppercase font-bold"
        >Certificações</span
      >
    </div>

    <h2 class="font-headline text-3xl md:text-4xl text-white mb-6">
      Conhecimento que se <span class="italic text-secondary">renova</span>
    </h2>

    <p class="text-on-surface-variant text-lg font-light leading-relaxed">
      A experiência prática é complementada por qualificação contínua. Cada
      formação reforça o compromisso com uma gestão mais eficiente,
      transparente e segura para o seu condomínio.
    </p>
  </div>

  <div class="flex flex-col gap-6">
    {
      rows.map((row) => (
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
          <CertificateCard
            {...row.tall}
            widths={[400, 600, 800]}
            sizes="(min-width: 1024px) 40vw, 100vw"
            class={row.reverse ? "lg:col-span-5 lg:order-2" : "lg:col-span-5"}
          />
          <div class="lg:col-span-7 flex flex-col gap-6">
            {row.wide.map((cert) => (
              <CertificateCard
                {...cert}
                widths={[500, 800, 1100]}
                sizes="(min-width: 1024px) 55vw, 100vw"
              />
            ))}
          </div>
        </div>
      ))
    }
  </div>

  <dialog
    id="cert-dialog"
    class="m-auto max-w-[95vw] max-h-[95vh] bg-transparent p-0 backdrop:bg-background/90 backdrop:backdrop-blur-sm"
  >
    <form method="dialog" class="flex justify-end mb-3">
      <button
        class="text-on-surface-variant hover:text-primary transition-colors flex items-center gap-2 font-label text-[10px] uppercase tracking-widest"
        aria-label="Fechar"
      >
        Fechar
        <span class="material-symbols-outlined text-2xl">close</span>
      </button>
    </form>
    <img
      id="cert-dialog-img"
      src=""
      alt=""
      class="max-w-full max-h-[85vh] w-auto h-auto mx-auto border border-outline-variant/40"
    />
  </dialog>
</section>

<script>
  const dialog = document.getElementById("cert-dialog") as HTMLDialogElement;
  const img = document.getElementById("cert-dialog-img") as HTMLImageElement;

  document.querySelectorAll<HTMLButtonElement>(".js-cert-open").forEach((btn) => {
    btn.addEventListener("click", () => {
      img.src = btn.dataset.full ?? "";
      img.alt = btn.dataset.alt ?? "";
      dialog.showModal();
    });
  });

  // Fecha ao clicar fora da imagem
  dialog.addEventListener("click", (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>
